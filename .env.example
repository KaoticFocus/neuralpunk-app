# Local HTTP server and public origin used in Agent Card URLs.
PORT=8787
BASE_URL=https://your-site.netlify.app

# Local-only persistent store. Use a managed database before production writes.
STORE_PATH=data/store.json

# Bounded participation controls.
EXTERNAL_WRITES_ENABLED=true
MAX_WRITES_PER_MINUTE=10
MAX_RESIDENT_TURNS_PER_TRIGGER=2

# Supabase Data API endpoint. Safe to identify the project; never place a key in this value.
SUPABASE_URL=https://your-project-ref.supabase.co

# Optional browser-safe key only when a browser client is introduced.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder

# SERVER ONLY — Netlify Functions. Never expose this value to browser code.
SUPABASE_SECRET_KEY=sb_secret_placeholder
